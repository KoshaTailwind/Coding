   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.stats import poisson\n",
    "\n",
    "lam = 14\n",
    "\n",
    "#Рассчет параметров\n",
    "mean = poisson.mean(mu=lam)\n",
    "var = poisson.var(mu=lam)\n",
    "std = poisson.std(mu=lam)\n",
    "skew = poisson.stats(mu=lam, moments=\"s\")\n",
    "kurt = poisson.stats(mu=lam, moments=\"k\")\n",
    "\n",
    "print(\"Параметры распределения Пуассона (λ=14):\")\n",
    "print(f\"Мат. ожидание: {mean}\")\n",
    "print(f\"Дисперсия: {var}\")\n",
    "print(f\"Среднеквадратичное отклонение: {std}\")\n",
    "print(\"Асимметрия:\", skew)\n",
    "print(\"Эксцесс:\", kurt)"
   ]
